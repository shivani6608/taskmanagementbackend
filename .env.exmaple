PORT=5000
NODE_ENV=development
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/task-management?
retryWrites=true&w=majority
# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d
# Cloudinary (cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Nodemailer via Gmail (use a Gmail App Password, not your normal password)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password
# OpenWeatherMap (openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key
# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173